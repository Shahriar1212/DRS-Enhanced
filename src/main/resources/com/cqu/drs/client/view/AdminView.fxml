<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cqu.drs.client.controller.AdminController">
    <VBox>
        <Label text="Administration &amp; Security" styleClass="page-title"/>
        <Label text="Access rights, tamper-evident signed audit log, and loading the DRS-Initial (Assessment 2) data into MySQL through the server." styleClass="page-subtitle"/>
    </VBox>
    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <Tab text="Users &amp; roles">
            <VBox spacing="10">
                <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="uIdCol" text="ID" prefWidth="45"/>
                        <TableColumn fx:id="uNameCol" text="Username" prefWidth="120"/>
                        <TableColumn fx:id="uFullCol" text="Full name" prefWidth="200"/>
                        <TableColumn fx:id="uRoleCol" text="Role" prefWidth="170"/>
                        <TableColumn fx:id="uActiveCol" text="Status" prefWidth="90"/>
                        <TableColumn fx:id="uCreatedCol" text="Created" prefWidth="130"/>
                    </columns>
                </TableView>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Button text="Enable / unlock selected" onAction="#enableUser"/>
                    <Button text="Disable selected" onAction="#disableUser" styleClass="danger-button"/>
                    <Button text="Refresh" onAction="#refreshUsers"/>
                </HBox>
                <VBox styleClass="card">
                    <Label text="Create account (password is PBKDF2-hashed; an RSA-2048 signing key pair is generated)" styleClass="section-title"/>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <TextField fx:id="newUsernameField" promptText="Username" prefWidth="130"/>
                        <TextField fx:id="newFullNameField" promptText="Full name" prefWidth="180"/>
                        <PasswordField fx:id="newPasswordField" promptText="Password" prefWidth="150"/>
                        <ComboBox fx:id="newRoleCombo" prefWidth="180"/>
                        <Button text="Create User" onAction="#createUser" styleClass="primary-button"/>
                    </HBox>
                </VBox>
            </VBox>
        </Tab>
        <Tab text="Audit log (non-repudiation)">
            <VBox spacing="10">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Button text="Verify integrity" onAction="#verifyAudit" styleClass="accent-button"/>
                    <Button text="Refresh" onAction="#refreshAudit"/>
                    <Label fx:id="auditResultLabel" wrapText="true"/>
                </HBox>
                <TableView fx:id="auditTable" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="auIdCol" text="#" prefWidth="45"/>
                        <TableColumn fx:id="auTimeCol" text="Timestamp" prefWidth="125"/>
                        <TableColumn fx:id="auUserCol" text="User" prefWidth="75"/>
                        <TableColumn fx:id="auActionCol" text="Action" prefWidth="150"/>
                        <TableColumn fx:id="auDetailsCol" text="Details" prefWidth="330"/>
                        <TableColumn fx:id="auHashCol" text="SHA-256 hash" prefWidth="140"/>
                        <TableColumn fx:id="auVerifiedCol" text="Signature" prefWidth="95"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>
        <Tab text="Import DRS-Initial data">
            <VBox spacing="10" styleClass="card">
                <Label text="Load the data collected with DRS-Initial (Assessment 2)" styleClass="section-title"/>
                <Label wrapText="true" text="The client reads the DRS-Initial CSV files (departments, resources, volunteers, disaster reports) and sends them to the multi-threaded server, which stores them in MySQL - encrypting phone numbers, signing reports, assessing them and writing audit entries. Rows that already exist are skipped, so importing twice is safe."/>
                <HBox spacing="8">
                    <Button text="Import bundled DRS-Initial data" onAction="#importBundled" styleClass="accent-button"/>
                    <Button text="Import from folder..." onAction="#importFromFolder"/>
                </HBox>
                <TextArea fx:id="importLogArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"/>
            </VBox>
        </Tab>
        <Tab text="Access rights">
            <VBox spacing="8">
                <Label wrapText="true" text="Minimum role needed for each server command (roles inherit: Public Reporter &lt; Field Officer &lt; Emergency Coordinator &lt; Administrator). Enforced by the server on every request."/>
                <TableView fx:id="permTable" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="permCmdCol" text="Command" prefWidth="260"/>
                        <TableColumn fx:id="permRoleCol" text="Minimum role" prefWidth="220"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>
    </TabPane>
    <Label fx:id="statusLabel" wrapText="true"/>
</VBox>
