<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cqu.drs.client.controller.CoordinationController">
    <HBox alignment="CENTER_LEFT">
        <VBox>
            <Label text="Response Coordination" styleClass="page-title"/>
            <Label text="Department tasks created by assessment. Assign volunteers, allocate department stock and track task status." styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Refresh" onAction="#refresh"/>
    </HBox>
    <TableView fx:id="tasksTable" VBox.vgrow="ALWAYS" prefHeight="330">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="taskIdCol" text="Task" prefWidth="50"/>
            <TableColumn fx:id="reportCol" text="Disaster" prefWidth="200"/>
            <TableColumn fx:id="descriptionCol" text="Description" prefWidth="290"/>
            <TableColumn fx:id="departmentCol" text="Department" prefWidth="150"/>
            <TableColumn fx:id="priorityCol" text="Priority" prefWidth="65"/>
            <TableColumn fx:id="statusCol" text="Status" prefWidth="95"/>
            <TableColumn fx:id="volunteerCol" text="Volunteer" prefWidth="120"/>
        </columns>
    </TableView>
    <HBox spacing="12">
        <VBox styleClass="card" HBox.hgrow="ALWAYS">
            <Label text="Assign a volunteer" styleClass="section-title"/>
            <ComboBox fx:id="volunteerCombo" maxWidth="Infinity" promptText="Available volunteers"/>
            <Button fx:id="assignButton" text="Assign Volunteer" onAction="#assignVolunteer" styleClass="primary-button"/>
        </VBox>
        <VBox styleClass="card" HBox.hgrow="ALWAYS">
            <Label text="Allocate department resource" styleClass="section-title"/>
            <ComboBox fx:id="resourceCombo" maxWidth="Infinity" promptText="Select a task first"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Qty:" styleClass="form-label"/>
                <TextField fx:id="quantityField" prefWidth="70"/>
                <Button fx:id="allocateButton" text="Allocate Resource" onAction="#allocateResource" styleClass="primary-button"/>
            </HBox>
        </VBox>
        <VBox styleClass="card" HBox.hgrow="ALWAYS">
            <Label text="Update task status" styleClass="section-title"/>
            <ComboBox fx:id="statusCombo" maxWidth="Infinity"/>
            <Button fx:id="statusButton" text="Update Status" onAction="#updateStatus" styleClass="primary-button"/>
        </VBox>
    </HBox>
    <Label fx:id="statusLabel" wrapText="true"/>
</VBox>
