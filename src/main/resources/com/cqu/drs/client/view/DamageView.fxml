<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cqu.drs.client.controller.DamageController">
    <HBox alignment="CENTER_LEFT">
        <VBox>
            <Label text="Damage Assessment &amp; Restoration Planning" styleClass="page-title"/>
            <Label text="New feature 2: record infrastructure damage; a prioritised restoration job is raised for the responsible department." styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Refresh" onAction="#refresh"/>
    </HBox>
    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <Tab text="Record damage">
            <HBox spacing="12">
                <VBox styleClass="card" prefWidth="400">
                    <Label text="Damage assessment" styleClass="section-title"/>
                    <GridPane hgap="8" vgap="8">

                        <columnConstraints><ColumnConstraints minWidth="125"/><ColumnConstraints hgrow="ALWAYS"/></columnConstraints>
                        <Label text="Disaster *" styleClass="form-label" GridPane.rowIndex="0"/>
                        <ComboBox fx:id="reportCombo" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label text="Infrastructure *" styleClass="form-label" GridPane.rowIndex="1"/>
                        <ComboBox fx:id="categoryCombo" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label text="Damage level *" styleClass="form-label" GridPane.rowIndex="2"/>
                        <ComboBox fx:id="levelCombo" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        <Label text="Est. cost ($) *" styleClass="form-label" GridPane.rowIndex="3"/>
                        <TextField fx:id="costField" promptText="e.g. 250000" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        <Label text="People affected *" styleClass="form-label" GridPane.rowIndex="4"/>
                        <TextField fx:id="affectedField" promptText="e.g. 120" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                        <Label text="Notes" styleClass="form-label" GridPane.rowIndex="5"/>
                        <TextArea fx:id="notesArea" wrapText="true" prefRowCount="3" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                    </GridPane>
                    <Label fx:id="previewLabel" styleClass="hint" wrapText="true"/>
                    <Button fx:id="recordButton" text="Record Damage &amp; Raise Job" onAction="#recordDamage" styleClass="accent-button"/>
                </VBox>
                <TableView fx:id="assessmentsTable" HBox.hgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="aIdCol" text="ID" prefWidth="40"/>
                        <TableColumn fx:id="aReportCol" text="Disaster" prefWidth="170"/>
                        <TableColumn fx:id="aCategoryCol" text="Infrastructure" prefWidth="150"/>
                        <TableColumn fx:id="aLevelCol" text="Damage" prefWidth="85"/>
                        <TableColumn fx:id="aCostCol" text="Est. cost" prefWidth="95"/>
                        <TableColumn fx:id="aAffectedCol" text="Affected" prefWidth="65"/>
                        <TableColumn fx:id="aByCol" text="Assessor" prefWidth="70"/>
                        <TableColumn fx:id="aAtCol" text="Assessed at" prefWidth="115"/>
                    </columns>
                </TableView>
            </HBox>
        </Tab>
        <Tab text="Restoration jobs &amp; recovery">
            <VBox spacing="10">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Disaster:" styleClass="form-label"/>
                    <ComboBox fx:id="filterCombo" prefWidth="320"/>
                </HBox>
                <HBox spacing="10">
                    <VBox styleClass="stat-card"><Label fx:id="summaryCostLabel" text="-" styleClass="stat-value"/><Label text="Estimated damage" styleClass="stat-label"/></VBox>
                    <VBox styleClass="stat-card"><Label fx:id="summaryAffectedLabel" text="-" styleClass="stat-value"/><Label text="People affected" styleClass="stat-label"/></VBox>
                    <VBox styleClass="stat-card"><Label fx:id="summaryJobsLabel" text="-" styleClass="stat-value"/><Label text="Jobs completed" styleClass="stat-label"/></VBox>
                    <VBox styleClass="stat-card" prefWidth="260">
                        <ProgressBar fx:id="summaryProgressBar" progress="0" prefWidth="230" styleClass="bar-ok"/>
                        <Label fx:id="summaryProgressLabel" text="-" styleClass="stat-label"/>
                    </VBox>
                </HBox>
                <TableView fx:id="jobsTable" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="jIdCol" text="Job" prefWidth="45"/>
                        <TableColumn fx:id="jReportCol" text="Report" prefWidth="55"/>
                        <TableColumn fx:id="jDescCol" text="Work" prefWidth="270"/>
                        <TableColumn fx:id="jDeptCol" text="Department" prefWidth="170"/>
                        <TableColumn fx:id="jPriorityCol" text="Priority" prefWidth="60"/>
                        <TableColumn fx:id="jDaysCol" text="Est. days" prefWidth="65"/>
                        <TableColumn fx:id="jProgressCol" text="Progress" prefWidth="150"/>
                        <TableColumn fx:id="jStatusCol" text="Status" prefWidth="95"/>
                    </columns>
                </TableView>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Progress of selected job:" styleClass="form-label"/>
                    <Slider fx:id="progressSlider" min="0" max="100" majorTickUnit="25" showTickMarks="true" showTickLabels="true" prefWidth="300"/>
                    <Label fx:id="progressValueLabel" text="0%" minWidth="40"/>
                    <Button fx:id="progressButton" text="Update Progress" onAction="#updateProgress" styleClass="primary-button"/>
                </HBox>
            </VBox>
        </Tab>
    </TabPane>
    <Label fx:id="statusLabel" wrapText="true"/>
</VBox>
