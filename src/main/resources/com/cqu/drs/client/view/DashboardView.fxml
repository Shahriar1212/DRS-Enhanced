<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cqu.drs.client.controller.DashboardController">
    <HBox alignment="CENTER_LEFT">
        <VBox>
            <Label text="Dashboard - Assessment &amp; Prioritisation" styleClass="page-title"/>
            <Label text="All reported disasters, most urgent first. Assessing a report scores it and coordinates the relevant departments automatically." styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Refresh" onAction="#refresh"/>
    </HBox>

    <HBox spacing="10">
        <VBox styleClass="stat-card"><Label fx:id="openReportsValue" text="-" styleClass="stat-value"/><Label text="Open reports" styleClass="stat-label"/></VBox>
        <VBox styleClass="stat-card, stat-critical"><Label fx:id="criticalValue" text="-" styleClass="stat-value"/><Label text="Critical (open)" styleClass="stat-label"/></VBox>
        <VBox styleClass="stat-card"><Label fx:id="tasksValue" text="-" styleClass="stat-value"/><Label text="Active response tasks" styleClass="stat-label"/></VBox>
        <VBox styleClass="stat-card, stat-alert"><Label fx:id="alertsValue" text="-" styleClass="stat-value"/><Label text="Active evacuation alerts" styleClass="stat-label"/></VBox>
        <VBox styleClass="stat-card"><Label fx:id="shelteredValue" text="-" styleClass="stat-value"/><Label text="People sheltered / capacity" styleClass="stat-label"/></VBox>
        <VBox styleClass="stat-card"><Label fx:id="damageValue" text="-" styleClass="stat-value"/><Label text="Estimated damage" styleClass="stat-label"/></VBox>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Search:" styleClass="form-label"/>
        <TextField fx:id="searchField" promptText="location, type, description or reporter" prefWidth="300"/>
        <Label text="Show:" styleClass="form-label"/>
        <ComboBox fx:id="statusFilter" prefWidth="160"/>
    </HBox>

    <TableView fx:id="reportsTable" VBox.vgrow="ALWAYS" prefHeight="300">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="idCol" text="ID" prefWidth="45"/>
            <TableColumn fx:id="typeCol" text="Type" prefWidth="95"/>
            <TableColumn fx:id="locationCol" text="Location" prefWidth="160"/>
            <TableColumn fx:id="severityCol" text="Severity" prefWidth="95"/>
            <TableColumn fx:id="priorityCol" text="Priority" prefWidth="65"/>
            <TableColumn fx:id="statusCol" text="Status" prefWidth="95"/>
            <TableColumn fx:id="reporterCol" text="Reported by" prefWidth="120"/>
            <TableColumn fx:id="phoneCol" text="Phone" prefWidth="105"/>
            <TableColumn fx:id="dateCol" text="Reported at" prefWidth="120"/>
            <TableColumn fx:id="signedCol" text="Signature" prefWidth="80"/>
        </columns>
    </TableView>

    <HBox spacing="12">
        <VBox styleClass="card" HBox.hgrow="ALWAYS">
            <Label text="Selected report" styleClass="section-title"/>
            <TextArea fx:id="detailsArea" editable="false" wrapText="true" prefRowCount="5"/>
        </VBox>
        <VBox styleClass="card" prefWidth="430">
            <Label text="Assess selected report" styleClass="section-title"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Severity:" styleClass="form-label"/>
                <ComboBox fx:id="severityCombo" prefWidth="130"/>
                <Button fx:id="assessButton" text="Assess &amp; Coordinate" onAction="#assess" styleClass="primary-button"/>
            </HBox>
            <Label fx:id="previewLabel" styleClass="hint" wrapText="true"/>
            <Button fx:id="resolveButton" text="Mark report resolved" onAction="#resolve"/>
            <Label fx:id="statusLabel" wrapText="true"/>
        </VBox>
    </HBox>
</VBox>
