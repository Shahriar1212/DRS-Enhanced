<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cqu.drs.client.controller.MainController">
    <fx:define>
        <ToggleGroup fx:id="navGroup"/>
    </fx:define>
    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT">
            <Label text="DRS" styleClass="logo-mark"/>
            <VBox>
                <Label text="Disaster Response System" styleClass="app-title"/>
                <Label text="DRS-Enhanced  |  multi-threaded client-server  |  MySQL" styleClass="app-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="userLabel" styleClass="user-name"/>
            <Label fx:id="roleLabel" styleClass="role-badge"/>
            <Button text="Log out" onAction="#logout" styleClass="logout-button"/>
        </HBox>
    </top>
    <left>
        <VBox styleClass="sidebar">
            <Label text="OPERATIONS" styleClass="sidebar-caption"/>
            <ToggleButton fx:id="dashboardNav" text="Dashboard / Assess" toggleGroup="$navGroup" onAction="#showDashboard" styleClass="nav-button"/>
            <ToggleButton fx:id="reportNav" text="Report Disaster" toggleGroup="$navGroup" onAction="#showReport" styleClass="nav-button"/>
            <ToggleButton fx:id="coordinationNav" text="Coordination" toggleGroup="$navGroup" onAction="#showCoordination" styleClass="nav-button"/>
            <ToggleButton fx:id="volunteerNav" text="Volunteers" toggleGroup="$navGroup" onAction="#showVolunteers" styleClass="nav-button"/>
            <ToggleButton fx:id="resourceNav" text="Departments &amp; Resources" toggleGroup="$navGroup" onAction="#showResources" styleClass="nav-button"/>
            <Label text="NEW IN DRS-ENHANCED" styleClass="sidebar-caption"/>
            <ToggleButton fx:id="evacuationNav" text="Evacuation &amp; Shelters" toggleGroup="$navGroup" onAction="#showEvacuation" styleClass="nav-button"/>
            <ToggleButton fx:id="damageNav" text="Damage &amp; Restoration" toggleGroup="$navGroup" onAction="#showDamage" styleClass="nav-button"/>
            <Label text="SYSTEM" styleClass="sidebar-caption"/>
            <ToggleButton fx:id="adminNav" text="Administration" toggleGroup="$navGroup" onAction="#showAdmin" styleClass="nav-button"/>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentPane" styleClass="content"/>
    </center>
    <bottom>
        <HBox styleClass="status-bar">
            <Label fx:id="connectionLabel"/>
        </HBox>
    </bottom>
</BorderPane>
