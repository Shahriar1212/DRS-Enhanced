<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cqu.drs.client.controller.ReportController">
    <HBox alignment="CENTER_LEFT">
        <VBox>
            <Label text="Report a Disaster" styleClass="page-title"/>
            <Label text="Your report is time-stamped, digitally signed with your account key and sent to coordinators for assessment." styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Refresh" onAction="#refresh"/>
    </HBox>
    <HBox spacing="14" VBox.vgrow="ALWAYS">
        <VBox styleClass="card" prefWidth="460">
            <Label text="New report" styleClass="section-title"/>
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="110"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <Label text="Disaster type *" styleClass="form-label" GridPane.rowIndex="0"/>
                <ComboBox fx:id="typeCombo" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Location *" styleClass="form-label" GridPane.rowIndex="1"/>
                <TextField fx:id="locationField" promptText="Suburb / street, e.g. Rockhampton CBD" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Description *" styleClass="form-label" GridPane.rowIndex="2"/>
                <TextArea fx:id="descriptionArea" wrapText="true" prefRowCount="5" promptText="What is happening? Any injuries or people trapped?" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                <Label text="Your name *" styleClass="form-label" GridPane.rowIndex="3"/>
                <TextField fx:id="reporterNameField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                <Label text="Your phone" styleClass="form-label" GridPane.rowIndex="4"/>
                <TextField fx:id="reporterPhoneField" promptText="e.g. 0400 123 456 (stored encrypted)" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            </GridPane>
            <Button text="Submit Report" onAction="#submitReport" styleClass="accent-button"/>
            <Label fx:id="statusLabel" wrapText="true"/>
        </VBox>
        <VBox spacing="12" HBox.hgrow="ALWAYS">
            <VBox styleClass="card" VBox.vgrow="ALWAYS">
                <Label text="My reports" styleClass="section-title"/>
                <TableView fx:id="myReportsTable" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="idCol" text="ID" prefWidth="45"/>
                        <TableColumn fx:id="typeCol" text="Type" prefWidth="95"/>
                        <TableColumn fx:id="locationCol" text="Location" prefWidth="160"/>
                        <TableColumn fx:id="severityCol" text="Severity" prefWidth="85"/>
                        <TableColumn fx:id="statusCol" text="Status" prefWidth="95"/>
                        <TableColumn fx:id="dateCol" text="Reported at" prefWidth="120"/>
                    </columns>
                </TableView>
            </VBox>
            <VBox styleClass="card" prefHeight="190">
                <Label text="Active evacuation warnings" styleClass="section-title"/>
                <ListView fx:id="alertsList" VBox.vgrow="ALWAYS"/>
            </VBox>
        </VBox>
    </HBox>
</VBox>
