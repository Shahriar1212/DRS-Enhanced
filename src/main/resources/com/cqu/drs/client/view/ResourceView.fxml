<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cqu.drs.client.controller.ResourceController">
    <HBox alignment="CENTER_LEFT">
        <VBox>
            <Label text="Departments &amp; Resource Inventory" styleClass="page-title"/>
            <Label text="Partner departments the DRS coordinates with, and their relief stock (rows in red are at or below reorder level)." styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Refresh" onAction="#refresh"/>
    </HBox>
    <Label text="Departments" styleClass="section-title"/>
    <TableView fx:id="departmentsTable" prefHeight="230">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="deptIdCol" text="ID" prefWidth="45"/>
            <TableColumn fx:id="deptNameCol" text="Department" prefWidth="230"/>
            <TableColumn fx:id="deptTypeCol" text="Type" prefWidth="180"/>
            <TableColumn fx:id="deptContactCol" text="Contact" prefWidth="140"/>
            <TableColumn fx:id="deptResCol" text="Resources held" prefWidth="110"/>
        </columns>
    </TableView>
    <Label text="Resource inventory" styleClass="section-title"/>
    <TableView fx:id="resourcesTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="resIdCol" text="ID" prefWidth="45"/>
            <TableColumn fx:id="resDeptCol" text="Department" prefWidth="200"/>
            <TableColumn fx:id="resNameCol" text="Resource" prefWidth="200"/>
            <TableColumn fx:id="resQtyCol" text="Available" prefWidth="85"/>
            <TableColumn fx:id="resReorderCol" text="Reorder at" prefWidth="85"/>
            <TableColumn fx:id="resStockCol" text="Stock" prefWidth="110"/>
            <TableColumn fx:id="resUpdatedCol" text="Last updated" prefWidth="130"/>
        </columns>
    </TableView>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Restock selected resource by:" styleClass="form-label"/>
        <TextField fx:id="restockField" prefWidth="80"/>
        <Button fx:id="restockButton" text="Restock" onAction="#restock" styleClass="primary-button"/>
        <Label fx:id="statusLabel" wrapText="true"/>
    </HBox>
</VBox>
